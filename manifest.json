{
  "manifest_version": 3,
  "name": "Vertical Tabs Pro",
  "version": "2.0.0",
  "description": "縦型タブバー - 右クリックメニュー・ブックマーク・タブグループ・検索対応",
  "permissions": [
    "tabs",
    "storage",
    "sidePanel",
    "activeTab",
    "bookmarks",
    "tabGroups"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
